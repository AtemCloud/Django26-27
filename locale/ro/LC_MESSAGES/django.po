msgstr "Valoarea „%(value)s” trebuie să fie True, False sau None."

msgid "String (unlimited)"
msgstr "Șir de caractere (nelimitat)"

msgid "“%(value)s” value has an invalid date format. It must be in YYYY-MM-DD format."
msgstr "Valoarea „%(value)s” are un format de dată invalid. Trebuie să fie în formatul AAAA-LL-ZZ."

msgid "“%(value)s” value has the correct format (YYYY-MM-DD) but it is an invalid date."
msgstr "Valoarea „%(value)s” are formatul corect (AAAA-LL-ZZ), dar este o dată invalidă."

msgid "“%(value)s” value has an invalid format. It must be in YYYY-MM-DD HH:MM[:ss[.uuuuuu]][TZ] format."
msgstr "Valoarea „%(value)s” are un format invalid. Trebuie să fie în formatul AAAA-LL-ZZ HH:MM[:ss[.uuuuuu]][TZ]."

msgid "“%(value)s” value has the correct format (YYYY-MM-DD HH:MM[:ss[.uuuuuu]][TZ]) but it is an invalid date/time."
msgstr "Valoarea „%(value)s” are formatul corect (AAAA-LL-ZZ HH:MM[:ss[.uuuuuu]][TZ]), dar este o dată/oră invalidă."

msgid "“%(value)s” value must be a decimal number."
msgstr "Valoarea „%(value)s” trebuie să fie un număr zecimal."

msgid "“%(value)s” value has an invalid format. It must be in [DD] [[HH:]MM:]ss[.uuuuuu] format."
msgstr "Valoarea „%(value)s” are un format invalid. Trebuie să fie în formatul [ZZ] [[HH:]MM:]ss[.uuuuuu]."

msgid "“%(value)s” value must be a float."
msgstr "Valoarea „%(value)s” trebuie să fie un număr real."

msgid "“%(value)s” value must be an integer."
msgstr "Valoarea „%(value)s” trebuie să fie un număr întreg."

msgid "“%(value)s” value must be either None, True or False."
msgstr "Valoarea „%(value)s” trebuie să fie None, True sau False."

msgid "Positive big integer"
msgstr "Număr întreg mare pozitiv"

msgid "“%(value)s” value has an invalid format. It must be in HH:MM[:ss[.uuuuuu]] format."
msgstr "Valoarea „%(value)s” are un format invalid. Trebuie să fie în formatul HH:MM[:ss[.uuuuuu]]."

msgid "“%(value)s” value has the correct format (HH:MM[:ss[.uuuuuu]]) but it is an invalid time."
msgstr "Valoarea „%(value)s” are formatul corect (HH:MM[:ss[.uuuuuu]]), dar este o oră invalidă."

msgid "“%(value)s” is not a valid binary value."
msgstr "„%(value)s” nu este o valoare binară validă."

msgid "“%(value)s” is not a valid UUID."
msgstr "„%(value)s” nu este un UUID valid."

