msgid_plural "Please submit at most %(num)d forms."
msgstr[0] "Trimiteți cel mult %(num)d formular."
msgstr[1] "Trimiteți cel mult %(num)d formulare."
msgstr[2] "Trimiteți cel mult %(num)d de formulare."

msgid "Please submit at least %(num)d form."
msgid_plural "Please submit at least %(num)d forms."
msgstr[0] "Trimiteți cel puțin %(num)d formular."
msgstr[1] "Trimiteți cel puțin %(num)d formulare."
msgstr[2] "Trimiteți cel puțin %(num)d de formulare."

msgid "“%(pk)s” is not a valid value."
msgstr "„%(pk)s” nu este o valoare validă."

msgid "%(datetime)s couldn’t be interpreted in time zone %(current_timezone)s; it may be ambiguous or it may not exist."
msgstr "%(datetime)s nu a putut fi interpretată în fusul orar %(current_timezone)s; poate fi ambiguă sau poate să nu existe."

